# Cloudflare Pages headers.
#
# DELIBERATELY ABSENT: Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy.
# ADR-003 refuses cross-origin isolation on purpose, to keep OAuth and payment
# popups working. Adding them here would silently switch every WASM codec onto a
# multi-threaded path this app has never tested (docs/12 D-48) and unfreeze the
# heap counter the perf suite deliberately treats as unreliable (D-45). If a
# future change needs SharedArrayBuffer, that is an ADR revision, not a header.

/sw.js
  # The service worker must ALWAYS be revalidated. A cached sw.js pins users to
  # whatever app version it was compiled against — and since the precache
  # manifest is baked into its bytes (docs/12 D-52), a stale worker keeps
  # serving a stale shell offline. Browsers cap SW script caching at 24h anyway;
  # this makes it immediate rather than relying on that ceiling.
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/precache-manifest.json
  # Read by tooling and diagnostics, never by the running worker (the manifest
  # is compiled in). No reason to serve a stale copy.
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  # Fingerprinted by Astro — the filename changes whenever the bytes do, so
  # these are safe to cache forever. This is where the WASM codecs live too.
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

  # ── Strict-Transport-Security ──────────────────────────────────────────
  #
  # Production served this header not at all (verified with curl against
  # keptpix.com, docs/12 D-88). Cloudflare redirects HTTP to HTTPS, but a
  # redirect still means the FIRST request of a session can leave the device in
  # cleartext — and for a product whose entire claim is about what does not
  # leave the device, that is the wrong default. HSTS makes the browser refuse
  # plaintext before any request is sent.
  #
  # `preload` is deliberately omitted: it requires submission to
  # hstspreload.org and removal takes months, so it is a one-way door that
  # should be walked through on purpose rather than acquired from a header edit.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Permissions-Policy ─────────────────────────────────────────────────
  #
  # Nothing in src/ calls getUserMedia, geolocation, or any sensor API —
  # verified by grep, not assumed. So denying them costs this app nothing and
  # buys a real guarantee: even with a script injected past the CSP, the page
  # cannot reach the camera or the microphone. For a tool people bring private
  # photos to, that is worth stating in a form the browser enforces.
  #
  # `payment` is NOT restricted. ADR-003 gave up cross-origin isolation
  # specifically to keep payment and OAuth popups working for the Phase 4
  # licence flow, and quietly closing that here would undo the trade.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), magnetometer=(), gyroscope=(), accelerometer=(), usb=(), serial=(), bluetooth=(), midi=(), display-capture=(), idle-detection=()

  # ── Content-Security-Policy ────────────────────────────────────────────
  #
  # This file previously said a CSP would be "belt-and-braces, not the
  # mechanism", on the reasoning that the app is same-origin by construction
  # and the privacy suite already asserts it. That reasoning was wrong in one
  # specific way, and production proved it (docs/12 D-66):
  #
  #   Cloudflare injected `static.cloudflareinsights.com/beacon.min.js` into
  #   every HTML response at the edge, which then POSTed ~940 bytes per
  #   pageview to /cdn-cgi/rum. None of it is in this repo — `grep` across
  #   dist/ finds nothing. "Same-origin by construction" is only true of code
  #   we wrote; it says nothing about what the host adds on the way out.
  #
  # So the CSP IS the mechanism. `script-src 'self'` means a browser refuses
  # the injected beacon whatever the dashboard says, and a future Cloudflare
  # default cannot quietly reintroduce it.
  #
  # Each directive below is the minimum this app actually needs:
  #   'unsafe-inline'      3 inline scripts — theme bootstrap (must run before
  #                        first paint), SW registration, install-prompt capture.
  #                        Does NOT permit external hosts, so the beacon stays
  #                        blocked.
  #   'wasm-unsafe-eval'   WebAssembly.compile for the libheif/avif/mozjpeg/
  #                        oxipng codecs. Without it every WASM decode fails.
  #   worker-src blob:     the image worker, and Vite's worker plumbing.
  #   img-src blob: data:  thumbnails and results are object URLs; the AVIF
  #                        capability probe is a data: URI.
  #   connect-src 'self'   fetching WASM binaries. No remote origin — which is
  #                        what stops the beacon's POST even if a script ran.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
