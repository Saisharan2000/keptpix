---
/**
 * src/components/astro/FaqSection.astro
 *
 * Spec: docs/09-seo-content-plan.md §3 — 4+ pair-specific Q/A
 *
 * Uses native <details>/<summary>, so it is fully interactive with ZERO
 * JavaScript and every answer is present in the raw HTML for crawlers that do
 * not render. Summary rows are >= 44px to satisfy WCAG 2.5.8 target size.
 *
 * No headings inside <summary>: the disclosure widget is already announced as a
 * button, and nesting a heading inside it degrades screen-reader output. The
 * matching FAQPage JSON-LD is emitted by SeoHead.
 */

interface Props {
  faq: Array<{ q: string; a: string }>;
  headingId?: string;
}

const { faq, headingId = 'faq-heading' } = Astro.props;
---

<section aria-labelledby={headingId}>
  <h2 id={headingId} class="m-0 text-2xl font-semibold tracking-tight text-text">
    Frequently asked questions
  </h2>

  <div class="mt-5 border-t border-border">
    {
      faq.map((item) => (
        <details class="group border-b border-border">
          <summary
            class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 text-base font-medium text-text"
          >
            {item.q}
            <svg
              class="shrink-0 transition-transform duration-[var(--duration-fast)] group-open:rotate-180"
              width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </summary>
          <p class="mt-0 mb-4 max-w-[68ch] text-base text-text-muted">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Safari still paints its own disclosure triangle without this. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
