---
/**
 * src/components/astro/Footer.astro
 *
 * Spec: docs/08-design-system.md §4.1
 * ZERO JavaScript.
 */

const groups = [
  {
    title: 'Tools',
    links: [
      { href: '/convert', label: 'Convert' },
      { href: '/compress', label: 'Compress' },
      { href: '/resize', label: 'Resize' },
      { href: '/metadata', label: 'Metadata' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/how-it-works', label: 'How it works' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/about', label: 'About' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-bg-subtle">
  <div class="mx-auto max-w-[var(--container-xl)] px-6 py-12">
    <div class="flex flex-wrap gap-12">
      <div class="min-w-56 flex-1">
        <p class="m-0 text-base font-bold tracking-tight text-text">NoUpload</p>
        <p class="mt-2 mb-0 max-w-80 text-sm text-text-muted">
          Image conversion and exact-target-size compression that runs entirely in your
          browser. Your files are never uploaded.
        </p>
      </div>

      {
        groups.map((g) => (
          <nav aria-label={g.title}>
            <h2 class="m-0 text-xs font-semibold tracking-[0.02em] text-text-muted uppercase">
              {g.title}
            </h2>
            <ul class="mt-3 mb-0 flex list-none flex-col gap-2 p-0">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-text-muted no-underline hover:text-text">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-12 mb-0 text-xs text-text-muted">
      &copy; {year} NoUpload. No accounts, no tracking, no uploads.
    </p>
  </div>
</footer>
