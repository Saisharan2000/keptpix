---
/**
 * src/components/astro/Footer.astro
 *
 * Spec: docs/08-design-system.md §4.1
 * ZERO JavaScript.
 */

import { publishedTools } from '../../core/tools';
import { TIP_URL, TIP_LABEL } from '../../content/site';

const groups = [
  {
    title: 'Tools',
    // Manifest tools derived, for the reason in Header.astro (docs/12 D-79):
    // a published tool must be reachable by construction, not by remembering.
    links: [
      { href: '/convert', label: 'Convert' },
      { href: '/compress', label: 'Compress' },
      { href: '/resize', label: 'Resize' },
      { href: '/metadata', label: 'Metadata' },
      ...publishedTools.map((tool) => ({ href: tool.slug, label: tool.name })),
      // The hub must itself be reachable from every page, or it is an orphan
      // that happens to link things (docs/12 D-79).
      { href: '/all-tools', label: 'Every tool' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/how-it-works', label: 'How it works' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/about', label: 'About' },
    ],
  },
];

const year = new Date().getFullYear();

/**
 * The footer's privacy line was UNCONDITIONAL while /privacy's disclosure is
 * conditional — so a build that sets PUBLIC_CF_BEACON_TOKEN would have named the
 * counter honestly on one page and denied it on all 32 (docs/12 D-111).
 *
 * Nothing sets that token today, so the claim is true and this branch is dormant.
 * It exists because the token lives in the Cloudflare Pages dashboard, not in this
 * repository: someone can enable analytics without touching a file here, and no
 * build would have failed. The most-read privacy claim on the site should not
 * depend on a setting nobody can see from the source.
 *
 * Read directly rather than via platform/analytics.ts for the same reason
 * privacy.astro does: docs/07 §2 gives components/astro/ no grant to platform/,
 * and this is one boolean. Both read the SAME variable, so they cannot disagree.
 */
const analyticsOn = (import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '').trim().length > 0;
---

<footer class="mt-auto border-t border-border bg-bg-subtle">
  <div class="mx-auto max-w-[var(--container-xl)] px-6 py-12">
    <div class="flex flex-wrap gap-12">
      <div class="min-w-56 flex-1">
        <p class="m-0 text-base font-bold tracking-tight text-text">KeptPix</p>
        <p class="mt-2 mb-0 max-w-80 text-sm text-text-muted">
          Image conversion and exact-target-size compression that runs entirely in your
          browser. Your files are never uploaded.
        </p>
      </div>

      {
        groups.map((g) => (
          <nav aria-label={g.title}>
            <h2 class="m-0 text-xs font-semibold tracking-[0.02em] text-text-muted uppercase">
              {g.title}
            </h2>
            <ul class="mt-3 mb-0 flex list-none flex-col gap-2 p-0">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-text-muted no-underline hover:text-text">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-12 mb-0 text-xs text-text-muted">
      &copy; {year} KeptPix. {
        analyticsOn
          ? 'No accounts, no uploads. One cookieless page counter — see Privacy.'
          : 'No accounts, no tracking, no uploads.'
      }
      {
        /* An outbound anchor, so nothing third-party loads until it is clicked.
           `noopener` denies the opened page a handle on this one; `noreferrer`
           stops the payment host learning which tool the visitor was using,
           which Referrer-Policy alone would still have sent as the origin. */
        TIP_URL !== '' && (
          <>
            {' · '}
            <a
              href={TIP_URL}
              rel="noopener noreferrer"
              class="underline decoration-dotted underline-offset-2 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {TIP_LABEL}
            </a>
          </>
        )
      }
    </p>
  </div>
</footer>
