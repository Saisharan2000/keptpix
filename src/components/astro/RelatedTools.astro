---
/**
 * src/components/astro/RelatedTools.astro
 *
 * Spec: docs/09-seo-content-plan.md §3 — 4-6 genuinely related routes
 *
 * Slugs are resolved against the published route data and UNRESOLVED ONES ARE
 * DROPPED. Milestone 1 ships a single pair route while heic-to-jpg already
 * lists four related slugs, so rendering them blindly would emit internal links
 * to pages that 404 until Milestone 6 — a real defect, and an SEO one. As waves
 * 2-4 add entries to formats.ts these light up on their own, with no code change.
 *
 * ZERO JavaScript.
 */
import { publishedFormatPairRoutes } from '../../content/formats';
import {
  publishedResizePresetRoutes,
  publishedSizePresetRoutes,
  formatTarget,
} from '../../content/presets';
import { publishedTools } from '../../core/tools';

interface Props {
  slugs?: string[];
  /** Slug of the current route, so a page never links to itself. */
  currentSlug?: string;
  /**
   * Absolute path of the current page, for routes that are not format pairs.
   *
   * The manifest tools are addressed by path (`/pdf/from-images`), not by a
   * bare slug, so `currentSlug` cannot exclude them and the PDF page would
   * list itself as a related tool.
   */
  currentPath?: string;
  headingId?: string;
}

const { slugs = [], currentSlug, currentPath, headingId = 'related-heading' } = Astro.props;

const pairLinks = slugs
  .filter((s) => s !== currentSlug)
  .map((s) => publishedFormatPairRoutes.find((r) => r.slug === s))
  .filter((r) => r !== undefined)
  .map((r) => ({ href: '/convert/' + r.slug, label: r.h1 }));

/**
 * Size-preset slugs, resolved against THEIR table (docs/12 D-113).
 *
 * "Unresolved ones are dropped" was written when format pairs were the only
 * table to resolve against, and the drop was doing its job — protecting launch
 * ordering. When the compress preset routes reused this component, their
 * relatedSlugs (`jpg-to-50kb`, `signature-to-20kb`, …) hit the format-pair
 * lookup, resolved to nothing, and were ALL dropped: every one of the nine
 * /compress/* pages shipped with zero links to its siblings, verified in the
 * built HTML. The drop is the right behaviour; it was pointed at one table
 * when the data lives in two.
 */
const sizeLinks = slugs
  .filter((s) => s !== currentSlug)
  .map((s) => publishedSizePresetRoutes.find((r) => r.slug === s))
  .filter((r) => r !== undefined)
  .map((r) => ({
    href: '/compress/' + r.slug,
    label: r.cardName ?? 'Compress to ' + formatTarget(r.targetBytes),
  }));

/**
 * The THIRD table (docs/12 D-130). D-113 taught that "unresolved slugs are
 * dropped" silently deletes every link whose table this component does not
 * know about — the resize presets are that third table, added the same day
 * their first entries shipped rather than after someone notices the links
 * missing.
 */
const resizeLinks = slugs
  .filter((s) => s !== currentSlug)
  .map((s) => publishedResizePresetRoutes.find((r) => r.slug === s))
  .filter((r) => r !== undefined)
  .map((r) => ({ href: '/resize/' + r.slug, label: r.h1 }));

/**
 * Manifest tools, derived — so cross-linking between the image routes and the
 * document tools happens by construction rather than by remembering (D-79).
 *
 * These come BEFORE the hubs because a specific tool is a better related link
 * than a category page, and after the pairs because a page about HEIC is more
 * related to other HEIC conversions than to a PDF builder.
 */
const toolLinks = publishedTools.map((tool) => ({ href: tool.slug, label: tool.name }));

/* Hub routes always exist, so they are a safe backfill to a useful link count. */
const hubLinks = [
  { href: '/all-tools', label: 'Every tool' },
  { href: '/convert', label: 'All converters' },
  { href: '/compress', label: 'Compress to an exact size' },
  { href: '/metadata', label: 'Inspect EXIF and GPS data' },
  { href: '/how-it-works', label: 'How this works without uploading' },
];

/* Size siblings first among the resolved slugs: on a compress page the author
   chose those slugs for THIS route, and a sibling limit is closer to the
   user's task than any converter. Order within each group is the author's. */
const links = [...sizeLinks, ...resizeLinks, ...pairLinks, ...toolLinks, ...hubLinks]
  .filter((link) => link.href !== currentPath)
  .slice(0, 6);
---

<section aria-labelledby={headingId}>
  <h2 id={headingId} class="m-0 text-2xl font-semibold tracking-tight text-text">Related tools</h2>
  <ul class="mt-5 grid list-none grid-cols-1 gap-2 p-0 sm:grid-cols-2">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class="block rounded-md border border-border px-4 py-3 text-sm text-text no-underline hover:border-border-strong hover:bg-bg-subtle"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
