---
/**
 * src/pages/formats/[format].astro  ->  /formats/heic
 *
 * Spec: docs/09-seo-content-plan.md §2.4 (Wave 3)
 *
 * TEMPLATE COMPLETE, CONTENT EMPTY — see the note in /resize/[preset].astro.
 * These are reference pages rather than tool pages: someone landing here wants
 * to understand a format, not convert a file. There is deliberately no island.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import FaqSection from '../../components/astro/FaqSection.astro';
import RelatedTools from '../../components/astro/RelatedTools.astro';
import { publishedFormatReferenceRoutes } from '../../content/formats';

export function getStaticPaths() {
  return publishedFormatReferenceRoutes.map((route) => ({
    params: { format: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;
---

<ContentLayout
  title={route.title}
  description={route.metaDescription}
  path={'/formats/' + route.slug}
  h1={route.h1}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Formats', path: '/formats/' + route.slug },
  ]}
>
  <section aria-labelledby="what-heading">
    <h2 id="what-heading" class="m-0 text-xl font-semibold text-text">What it is</h2>
    <p class="mt-3 mb-0 max-w-[68ch] text-base text-text-muted">{route.intro}</p>
  </section>

  <section aria-labelledby="support-heading">
    <h2 id="support-heading" class="m-0 text-xl font-semibold text-text">Where it works</h2>
    <!-- Focusable for the same reason as FormatSpecTable — see docs/12 D-55. -->
    <div class="mt-4 overflow-x-auto" tabindex="0" role="region" aria-labelledby="support-heading">
      <table class="w-full min-w-[28rem] border-collapse text-left">
        <caption class="sr-only">Platform support for {route.h1}</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b border-border-strong px-4 py-3 text-sm font-semibold text-text">
              Platform
            </th>
            <th scope="col" class="border-b border-border-strong px-4 py-3 text-sm font-semibold text-text">
              Support
            </th>
          </tr>
        </thead>
        <tbody>
          {
            route.support.map((row) => (
              <tr>
                <th scope="row" class="border-b border-border px-4 py-3 align-top text-sm font-medium text-text">
                  {row.platform}
                </th>
                <td class="border-b border-border px-4 py-3 align-top text-sm text-text-muted">
                  {row.status}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="when-heading">
    <h2 id="when-heading" class="m-0 text-xl font-semibold text-text">When to use it</h2>
    <ul class="mt-4 flex list-none flex-col gap-3 p-0">
      {
        route.whenToUse.map((item) => (
          <li class="flex max-w-[68ch] gap-3 text-base text-text-muted">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-success" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-6 mb-0 text-base font-semibold text-text">When not to</h3>
    <ul class="mt-3 flex list-none flex-col gap-3 p-0">
      {
        route.whenNotToUse.map((item) => (
          <li class="flex max-w-[68ch] gap-3 text-base text-text-muted">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-warning" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <FaqSection faq={route.faq} />
  <RelatedTools slugs={route.relatedSlugs} />
</ContentLayout>
