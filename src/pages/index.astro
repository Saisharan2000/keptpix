---
/**
 * src/pages/index.astro  ->  /
 *
 * Spec: docs/09-seo-content-plan.md §2.4 — homepage, tool + positioning.
 *
 * The homepage is a landing page, not a tool page. Someone arriving here has no
 * file in hand and no specific task; they are deciding whether to trust this.
 * The routes below are the actual entry points, so the job here is to say what
 * this is, why it is different, and get out of the way.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import PrivacyBanner from '../components/astro/PrivacyBanner.astro';
import ToolCard from '../components/astro/ToolCard.astro';
import { QueryMatcher } from '../components/react/QueryMatcher';
import { categories, commonFixes, documentCards } from '../content/tool-cards';
---

<ContentLayout
  title="KeptPix — image and PDF tools that never upload your files"
  description="Convert images, compress to an exact size, and build or split PDFs — entirely in your browser. No upload, no sign-up, no quotas."
  path="/"
  h1="Image and PDF tools that never upload your files"
  lede="Every conversion runs on your own device, inside this tab. Nothing is sent anywhere — and you can verify that yourself in about a minute."
>
  {/*
    Search first, cards second, and both above the fold on a phone.

    Someone arriving with a task in their own words ("convert my iphone photos")
    should not have to translate it into our taxonomy. But someone who does not
    know what to type needs something to SCAN — which is the whole diagnosis
    behind the redesign: the page used to be text lists under headings, so
    finding anything required reading.

    The cards also stay as plain links, so they are the internal linking that
    makes these routes crawlable (docs/12 D-79) and they work with JavaScript
    off, which the matcher cannot.

    `client:load`, not `client:visible`: it is the first thing on the page, so
    deferring hydration until it scrolls into view means deferring until after
    someone has already tried to type in it.
  */}
  <section aria-labelledby="search-heading">
    <h2 id="search-heading" class="sr-only">Find a tool</h2>
    <QueryMatcher client:load label="What do you need to do?" />
    <noscript>
      <p class="mt-3 mb-0 text-sm text-text-muted">
        Search needs JavaScript. Every tool below is an ordinary link and works
        without it.
      </p>
    </noscript>
  </section>

  <section aria-labelledby="common-heading">
    <h2
      id="common-heading"
      class="m-0 text-sm font-semibold tracking-wider text-text-muted uppercase"
    >
      Common fixes
    </h2>
    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        commonFixes.map((card) => (
          <li>
            <ToolCard
              href={card.href}
              name={card.name}
              description={card.description}
              icon={card.icon}
            />
          </li>
        ))
      }
    </ul>
  </section>

  {
    documentCards.length > 0 && (
      <section aria-labelledby="documents-heading">
        <h2
          id="documents-heading"
          class="m-0 text-sm font-semibold tracking-wider text-text-muted uppercase"
        >
          PDF and documents
        </h2>
        <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {documentCards.map((card) => (
            <li>
              <ToolCard
                href={card.href}
                name={card.name}
                description={card.description}
                icon={card.icon}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="browse-heading">
    <h2
      id="browse-heading"
      class="m-0 text-sm font-semibold tracking-wider text-text-muted uppercase"
    >
      Browse by category
    </h2>
    <ul class="mt-4 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-3">
      {
        categories.map((category) => (
          <li>
            <a
              href={category.href}
              class="block rounded-lg border border-border bg-surface p-4 no-underline hover:border-border-strong hover:bg-bg-subtle"
            >
              <span class="flex items-baseline justify-between gap-2">
                <span class="font-semibold text-text">{category.name}</span>
                <span class="num text-sm tabular-nums text-text-muted">{category.count}</span>
              </span>
              <span class="mt-1 block text-sm text-text-muted">{category.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="why-heading">
    <h2 id="why-heading" class="m-0 text-2xl font-semibold tracking-tight text-text">
      Why this is different
    </h2>
    <div class="mt-5 flex flex-col gap-5">
      <div class="max-w-[68ch]">
        <strong class="block text-base font-semibold text-text">Your files never leave the device</strong>
        <span class="mt-1 block text-base text-text-muted">
          There is no server doing the work, so there is nowhere for your photos to go. Not a
          policy promise — an architectural fact, and one you can confirm by converting a file
          with your network disconnected.
        </span>
      </div>
      <div class="max-w-[68ch]">
        <strong class="block text-base font-semibold text-text">No quotas, because there is no bill</strong>
        <span class="mt-1 block text-base text-text-muted">
          No upload caps, no daily quota, no sign-up, no watermarks. Your device does the work, so
          serving one user costs the same as serving none — there is no cost to ration. Your
          device's own memory is the only real limit.
        </span>
      </div>
      <div class="max-w-[68ch]">
        <strong class="block text-base font-semibold text-text">EXIF and GPS removed by default</strong>
        <span class="mt-1 block text-base text-text-muted">
          Phone photos carry your coordinates to within a few metres, the camera model and the
          exact capture time. That is stripped unless you ask to keep it — and you can inspect
          exactly what a file contains before converting it.
        </span>
      </div>
      <div class="max-w-[68ch]">
        <strong class="block text-base font-semibold text-text">Exact target sizes, not a quality guess</strong>
        <span class="mt-1 block text-base text-text-muted">
          Most tools hand you a slider and let you hunt. This searches for the size you asked for
          and shows you the real progress while it does — "pass 4 of 8, 112 KB" rather than a
          spinner that means nothing.
        </span>
      </div>
    </div>
  </section>

  <PrivacyBanner />
</ContentLayout>
