---
/**
 * src/pages/[category]/[tool].astro  ->  /pdf/from-images, /video/compress, …
 *
 * Spec: docs/kepttools/03 §1 (ToolManifest), docs/kepttools/04 §2 (route matrix)
 *
 * ONE route file generates every tool page in the property. getStaticPaths reads
 * `publishedTools`, which has the `supported` gate already applied, so a tool
 * whose engine does not exist yet builds nothing at all — no page, no sitemap
 * entry, no internal link.
 *
 * Adding a tool is therefore a manifest edit plus a runner plus a copy entry.
 * No file is created here, ever.
 *
 * Page copy comes from `content/tool-copy.ts`, keyed by tool id. A tool with no
 * copy yet still builds — it renders the frame without the prose sections —
 * because an engine should be able to ship before its copy is written.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import FaqSection from '../../components/astro/FaqSection.astro';
import PrivacyBanner from '../../components/astro/PrivacyBanner.astro';
import { ManifestToolShell } from '../../components/react/ManifestToolShell';
import { publishedTools } from '../../core/tools';
import { copyForTool } from '../../content/tool-copy';

export function getStaticPaths() {
  return publishedTools.map((tool) => {
    // '/pdf/merge' -> category 'pdf', tool 'merge'
    const [, category, name] = tool.slug.split('/');
    return { params: { category, tool: name }, props: { tool } };
  });
}

const { tool } = Astro.props;
const copy = copyForTool(tool.id);

const lede =
  copy?.lede ?? 'Free, unlimited, and 100% in your browser. Your files are never uploaded.';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: tool.name, path: tool.slug },
];

const webApp = {
  name: tool.name,
  featureList: [
    tool.name + ' entirely in the browser',
    'No upload — files never leave the device',
    'No sign-up, no watermarks, no file-size caps',
  ],
};
---

<ToolLayout
  title={copy?.title ?? tool.name + ' — nothing uploaded'}
  description={
    copy?.metaDescription ??
    tool.name + ' in your browser. Nothing is uploaded, nothing is stored.'
  }
  path={tool.slug}
  h1={tool.name}
  lede={lede}
  faq={copy?.faq ? [...copy.faq] : undefined}
  breadcrumbs={breadcrumbs}
  webApp={webApp}
>
  <Fragment slot="tool">
    <div id="tool" tabindex="-1" class="scroll-mt-20">
      <ManifestToolShell client:visible tool={tool} />

      <noscript>
        <p class="mt-4 mb-0 rounded-md border border-warning bg-warning-subtle px-4 py-3 text-sm text-text">
          This tool needs JavaScript, because the work runs on your device rather
          than on a server. Everything you can read on this page works without it.
        </p>
      </noscript>
    </div>
  </Fragment>

  {
    copy?.sections.map((section, index) => (
      <section aria-labelledby={'section-' + index}>
        <h2
          id={'section-' + index}
          class="m-0 text-2xl font-semibold tracking-tight text-text"
        >
          {section.heading}
        </h2>
        {section.paragraphs.map((paragraph) => (
          <p class="mt-4 mb-0 max-w-[68ch] text-base text-text-muted">{paragraph}</p>
        ))}
      </section>
    ))
  }

  {
    copy?.useCases && copy.useCases.length > 0 && (
      <section aria-labelledby="uses-heading">
        <h2 id="uses-heading" class="m-0 text-2xl font-semibold tracking-tight text-text">
          What people use this for
        </h2>
        <ul class="mt-4 flex list-none flex-col gap-3 p-0">
          {copy.useCases.map((useCase) => (
            <li class="flex max-w-[68ch] gap-3 text-base text-text-muted">
              <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              <span>{useCase}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {copy?.faq && <FaqSection faq={[...copy.faq]} />}

  <PrivacyBanner />
</ToolLayout>
